# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must never be committed.

# ── NVIDIA API ────────────────────────────────────────────────────────────────
# Get a free key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any chat model available on the NVIDIA API (default shown below)
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Base URL — only change this if you're using a self-hosted NVIDIA endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── PostgreSQL (used by load_data.py) ─────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=olist

# ── LLM cache ─────────────────────────────────────────────────────────────────
# Directory where LLM responses are cached (SHA-256 keyed JSON files)
LLM_CACHE_DIR=.llm_cache
